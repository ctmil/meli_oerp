<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            26.332 (caso-K01): cambios de producto de MercadoLibre (ordenes con tag `change`).
            Vincula la orden de reemplazo con la venta original (via reclamo /changes) y, cuando la
            devolucion de ML figura entregada, registra el reingreso en la venta ORIGINAL segun la
            politica de devoluciones (FULL / cancel_return_full / mercadolibre_return_mode).
            Solo LECTURA contra ML. Desactivado por defecto: activarlo por cliente.
        -->
        <record id="ir_cron_meli_change_sync" model="ir.cron">
            <field name="name">MELI: cambios de producto (vincular + reingreso del devuelto)</field>
            <field name="model_id" ref="model_mercadolibre_orders"/>
            <field name="state">code</field>
            <field name="code">model.cron_meli_change_sync(limit=50)</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
