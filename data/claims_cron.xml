<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Cron de sincronizacion de reclamos post-venta de MercadoLibre.
            READ-ONLY: trae los reclamos abiertos del vendedor y los upserta
            localmente (no ejecuta acciones que muten en ML).
            Desactivado por defecto (active=False): activarlo cuando se quiera
            sincronizar reclamos (Fase 1). Las acciones de resolucion son Fase 2.
        -->
        <record id="ir_cron_meli_sync_claims" model="ir.cron">
            <field name="name">MELI: sincronizar reclamos post-venta (read-only)</field>
            <field name="model_id" ref="model_mercadolibre_claim"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_claims(status="opened", limit=50)</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
