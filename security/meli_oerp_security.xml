<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- [26.392] Categoría propia «Mercado Libre» (dentro de Ventas en el form de usuario). Antes los grupos iban en
         base.module_category_sales_sales sin cadena de implied_ids => el core 16-18 pasaba TODA la categoría Ventas a
         casillas sólo visibles en modo desarrollador. Niveles en cadena => UN selector, sin modo desarrollador:
         Lector < Encargado (meli_oerp) < Administrador (meli_oerp_multiple, si está instalado). -->
    <record model="ir.module.category" id="module_category_mercadolibre">
        <field name="name">Mercado Libre</field>
        <field name="sequence">25</field>
        <field name="parent_id" ref="base.module_category_sales"/>
        <field name="description">Acceso a Mercado Libre: Lector (sólo consulta), Encargado (opera ventas, publicaciones y stock), Administrador (cuentas y configuración, con Mercado Libre Multiple).</field>
    </record>

    <record id="group_mercadolibre_reader" model="res.groups">
        <field name="name">MercadoLibre Sale Reader</field>
        <field name="category_id" ref="module_category_mercadolibre"/>
        <field name="comment">Lector: consulta órdenes, envíos, pagos, preguntas y reclamos de Mercado Libre (sólo lectura).</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_mercadolibre_manager" model="res.groups">
        <field name="name">MercadoLibre Sale Manager</field>
        <field name="category_id" ref="module_category_mercadolibre"/>
        <field name="implied_ids" eval="[(4, ref('group_mercadolibre_reader'))]"/>
        <field name="comment">Encargado: opera Mercado Libre (órdenes, publicaciones, stock, preguntas). Incluye Lector.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record model="ir.rule" id="mercadolibre_orders_comp_rule">
        <field name="name">MercadoLibre Order multi-company</field>
        <field name="model_id" ref="model_mercadolibre_orders"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="mercadolibre_shipment_comp_rule">
        <field name="name">MercadoLibre Shipment multi-company</field>
        <field name="model_id" ref="model_mercadolibre_shipment"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>


    		<record model="ir.rule" id="mercadolibre_questions_comp_rule">
    				<field name="name">MercadoLibre Questions multi-company</field>
    				<field name="model_id" ref="model_mercadolibre_questions"/>
    				<field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    		</record>

</odoo>
