<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_meli_shipment_tree">
            <field name="name">mercadolibre.shipment.tree</field>
            <field name="model">mercadolibre.shipment</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
              <tree string="Shipment" default_order="date_created desc">
                  <field name="company_id"/>
                  <field name="name"/>
                  <field name="shipping_id"/>
                  <field name="status"/>
                  <field name="substatus"/>
                  <field name="date_created"/>
                  <field name="last_updated"/>
                  <field name="tracking_method" />
                  <field name="receiver_address_name"/>
                  <field name="mode"/>
                  <field name="shipping_mode"/>
                  <field name="order_cost"/>
                  <field name="base_cost"  invisible="1"/>
                  <field name="tracking_number"/>
                  <field name="logistic_type" optional="show"/>
                  <field name="estimated_handling_limit" optional="show"/>
                  <field name="handling_limit_status" optional="show" widget="badge"
                         decoration-success="handling_limit_status == 'ok'"
                         decoration-warning="handling_limit_status == 'urgent'"
                         decoration-danger="handling_limit_status == 'overdue'"/>
                  <field name="estimated_delivery_date" optional="show"/>
                  <field name="date_shipped" optional="hide"/>
                  <field name="date_delivered" optional="hide"/>
                  <field name="comments"/>
                  <field name="receiver_id"  invisible="1"/>
                  <field name="sender_id"  invisible="1"/>
                  <field name="pdf_file"/>
                  <field name="pdf_link" invisible="1"/>
                  <field name="pdfimage_file"/>
                  <field name="pack_order" invisible="1"/>
              </tree>
            </field>
        </record>


        <record model="ir.ui.view" id="view_meli_shipment_form">
            <field name="name">mercadolibre.shipment.form</field>
            <field name="model">mercadolibre.shipment</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Shipment">
                  <sheet>
                    <div id="button_box" class="oe_button_box" style="width: auto;">
                      <button class="oe_stat_button" type="object" name="update"
                          icon="fa-car">
                          <field string="Status" name="status" widget="statinfo"/>
                      </button>
                      <button class="oe_stat_button" type="object" name="update"
                          icon="fa-refresh">
                          <field string="Sub-Status" name="substatus" widget="statinfo"/>
                      </button>
                    </div>
                    <div class="oe_title">
                      <h1><field name="name"/></h1>
                      <h5><field name="shipping_id"/></h5>
                    </div>
                    <div class="oe_button_box" name="button_box_mel" style="width: auto;">
                      <button name='update' type="object"
                        string="Actualizar"
                        invisible="order_id == False"
                        class="oe_stat_button"
                        icon="fa-refresh"/>
                    </div>
                    <group string="Details">
                      <group>
                        <field name="company_id"/>
                        <field name="date_created"/>
                        <field name="last_updated"/>
                        <field name="order_cost"/>
                        <field name="base_cost"/>
                        <field name="promoted_amount"/>
                        <field name="shipping_seller_cost"  widget="monetary"/>
                        <field name="shipping_cost"  widget="monetary"/>
                        <field name="shipping_list_cost"  widget="monetary"/>
                      </group>
                      <group>
                        <field name="tracking_method" />
                        <field name="tracking_number"/>
                        <field name="comments"/>
                        <field name="mode"/>
                        <field name="shipping_mode"/>
                        <field name="logistic_type"/>
                      </group>
                    </group>
                    <group string="Orders">
                      <group>
                        <!--field name="shipment_items"/-->
                      </group>
                      <group>
                        <field name="posting_id" invisible="1"/>
                        <field name="sale_order" />
                        <field name="order_id" />
                      </group>
                      <group>
                        <field name="order" />
                        <field name="pack_order" />
                        <field name="orders" />
                      </group>
                    </group>
                    <group string="Receiver/Sender">
                      <group>
                        <field name="receiver_id"/>
                        <field name="receiver_address_id"/>
                        <field name="receiver_address_phone"/>
                        <field name="receiver_address_name"/>
                        <field name="receiver_address_comment"/>
                        <field name="receiver_address_line"/>
                        <field name="receiver_street_number"/>
                        <field name="receiver_city"/>
                        <field name="receiver_city_code"/>
                        <field name="receiver_state"/>
                        <field name="receiver_state_code"/>
                        <field name="receiver_state_id"/>
                        <field name="receiver_country"/>
                        <field name="receiver_country_code"/>
                        <field name="receiver_country_id"/>
                        <field name="receiver_zip_code"/>
                        <field name="receiver_latitude"/>
                        <field name="receiver_longitude"/>
                      </group>
                      <group>
                        <field name="sender_id"/>
                        <field name="sender_address_id"/>
                        <field name="sender_address_line"/>
                        <field name="sender_address_comment"/>
                        <field name="sender_street_name"/>
                        <field name="sender_street_number"/>
                        <field name="sender_city"/>
                        <field name="sender_state"/>
                        <field name="sender_country"/>
                        <field name="sender_latitude"/>
                        <field name="sender_longitude"/>
                      </group>
                    </group>
                    <group string="Fechas de envío">
                      <group string="Fechas estimadas">
                        <field name="estimated_delivery_date"/>
                        <field name="estimated_delivery_limit"/>
                        <field name="estimated_delivery_final"/>
                        <field name="estimated_handling_limit"/>
                        <field name="estimated_delivery_extended"/>
                      </group>
                      <group string="Fechas reales (status_history)">
                        <field name="date_handling"/>
                        <field name="date_ready_to_ship"/>
                        <field name="date_shipped"/>
                        <field name="date_delivered"/>
                        <field name="date_first_visit"/>
                        <field name="date_not_delivered"/>
                        <field name="date_returned"/>
                        <field name="date_cancelled"/>
                      </group>
                    </group>
                    <group string="Guias">
                      <group>
                        <field name="pdf_file" filename="pdf_filename"/>
                        <field name="pdf_filename"/>
                        <field name="pdf_link" widget="url"/>
                      </group>
                      <group>
                        <field name="pdfimage_file" filename="pdfimage_filename"/>
                        <field name="pdfimage_filename"/>
                      </group>
                    </group>
                  </sheet>
                  <div class="oe_chatter">
                      <field name="message_follower_ids" widget="mail_followers"/>
                      <field name="activity_ids" widget="mail_activity"/>
                      <field name="message_ids" widget="mail_thread"/>
                  </div>
                </form>
            </field>
        </record>

        <record id="meli_shipment_search_view" model="ir.ui.view">
            <field name="name">MercadoLibre Shipment - Search</field>
            <field name="model">mercadolibre.shipment</field>
            <field name="arch" type="xml">
        	    <search>
                    <field name="shipping_id" />
                    <field name="status"/>
                    <field name="substatus"/>
                    <field name="logistic_type"/>
                    <field name="tracking_method" />
                    <field name="receiver_address_name"/>
                    <field name="tracking_number"/>

                    <!-- Filtros de estado -->
                    <filter name="status_handling" string="En preparación (handling)"
                            domain="[('status','=','handling')]"/>
                    <filter name="status_ready_to_ship" string="Listo para enviar"
                            domain="[('status','=','ready_to_ship')]"/>
                    <filter name="status_shipped" string="Enviado"
                            domain="[('status','=','shipped')]"/>
                    <separator/>

                    <!-- Filtros por tipo logístico -->
                    <filter name="logistic_cross_docking" string="Cross Docking"
                            domain="[('logistic_type','=','cross_docking')]"/>
                    <filter name="logistic_self_service" string="Self Service"
                            domain="[('logistic_type','=','self_service')]"/>
                    <filter name="logistic_fulfillment" string="Fulfillment"
                            domain="[('logistic_type','=','fulfillment')]"/>
                    <separator/>

                    <!-- Filtro clave: órdenes con fecha límite de despacho activa -->
                    <filter name="con_handling_limit" string="Con fecha límite despacho"
                            domain="[('estimated_handling_limit','!=',False)]"/>
                    <filter name="handling_vencido" string="Límite despacho vencido"
                            domain="[('estimated_handling_limit','&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                    <separator/>

                    <!-- Agrupaciones -->
                    <filter name="group_status" string="Estado"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_logistic_type" string="Tipo logístico"
                            context="{'group_by': 'logistic_type'}"/>
                    <filter name="group_substatus" string="Sub-estado"
                            context="{'group_by': 'substatus'}"/>
        	    </search>
            </field>
        </record>


        <record model="ir.actions.act_window" id="action_meli_shipment_tree">
