<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="view_meli_banner_tree">
            <field name="name">mercadolibre.banner.tree</field>
            <field name="model">mercadolibre.banner</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Descripciones" >
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_meli_banner_form">
  					<field name="name">mercadolibre.banner.form</field>
  					<field name="model">mercadolibre.banner</field>
  					<field name="arch" type="xml">
  						<form string="MercadoLibre Banner">
  							<header>

  							</header>
  							<sheet>
  								<div class="oe_title">
  									<h1><field name="name"/></h1>
  								</div>
                    <!--div class="oe_button_box" name="button_box_mel" style="width: auto;">
                      <button name='copy_from_company' type="object"
    											string="Copiar de Cia"
    											title="Copiar de Cia"
    											class="oe_stat_button"
    											icon="fa-user-circle"/>
                    </div-->
                  <div class="alert alert-info" role="alert">
                    <b>Se puede escribir con formato y con datos del producto.</b><br/>
                    Datos: <code>{p.campo}</code> del producto (incluye los campos de Studio, por
                    ejemplo <code>{p.x_studio_set}</code>) &#183; <code>{ml.campo}</code> de la
                    publicación (<code>{ml.meli_price}</code>) &#183; <code>{attr.ATRIBUTO}</code>
                    para un atributo ya resuelto de Mercado Libre (<code>{attr.RARITY_TYPE}</code>).<br/>
                    Formato: <code># Título</code>, <code>**negrita**</code>, <code>- viñeta</code>,
                    <code>[texto](url)</code>.
                    <b>Mercado Libre muestra la descripción como texto plano</b>, así que el formato
                    se aplana al publicar: los títulos van en mayúsculas y las marcas no se ven.<br/>
                    Si un dato está vacío, <b>esa línea completa no se publica</b>. Si el nombre del
                    campo no existe, el texto queda a la vista tal cual — es la señal de que está mal
                    escrito.
                  </div>
                  <!-- [#539] Asignacion automatica: la plantilla declara a que categorias
                       aplica. Vacio = se asigna a mano en el producto, como hasta ahora. -->
                  <group name="gcategorias" string="Se asigna sola a estas categorias">
                    <field name="meli_category_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="odoo_categ_ids" widget="many2many_tags" options="{'no_create': True}"/>
                  </group>
                  <group name="gheader" string="Encabezado">
                    <field name="header" nolabel="1" placeholder="Ej.: # {p.name}"/>
                  </group>
                  <group name="gdescription" string="Cuerpo">
                    <field name="description" nolabel="1"
                           placeholder="Ej.: **Set:** {p.x_studio_set}&#10;**Condición:** {attr.ITEM_CONDITION}&#10;&#10;Si se deja vacío se usa la descripción del producto."/>
                  </group>
                  <group name="gfooter" string="Pie">
                    <field name="footer" nolabel="1"/>
                  </group>
                  <group name="gimages" string="Images">
                    <!--field name="images"/>
                    <field name="images_id"/-->
                    <field name="images_id" class="o_website_sale_image_list" context="{'default_name': name}" mode="kanban" add-label="Add a Media" nolabel="1"/>

                  </group>
                </sheet>
              </form>
            </field>
          </record>


          <record id="view_mercadolibre_image_form" model="ir.ui.view">
              <field name="name">mercadolibre.image.view.form</field>
              <field name="model">mercadolibre.image</field>
              <field name="arch" type="xml">
                  <form string="MercadoLibre Images">
                      <field name="sequence" invisible="1"/>
                      <div class="row o_website_sale_image_modal">
                          <div class="col-md-6 col-xl-5">
                              <label for="name" string="Image Name"/>
                              <h2><field name="name" placeholder="Image Name"/></h2>
                              <label for="video_url" string="Video URL"/><br/>
                              <field name="video_url"/><br/>
                          </div>
                          <div class="col-md-6 col-xl-7 text-center o_website_sale_image_modal_container">
                              <div class="row">
                                  <div class="col">
                                      <field name="image_1920" widget="image"/>
                                  </div>
                                  <div class="col" 
					invisible="video_url in ['', False]">
                                      <div class="o_video_container p-2">
                                          <span>Video Preview</span>
                                          <field name="embed_code" class="mt-2" widget="video_preview"/>
                                          <h4 class="o_invalid_warning text-muted text-center" 
						invisible="embed_code != False">
                                              Please enter a valid Video URL.
                                          </h4>
                                      </div>
                                  </div>
                              </div>
                          </div>
                      </div>
                  </form>
              </field>
          </record>
          <record id="mercadolibre_image_view_kanban" model="ir.ui.view">
            <field name="name">mercadolibre.image.view.kanban</field>
            <field name="model">mercadolibre.image</field>
            <field name="arch" type="xml">
                <kanban string="MercadoLibre Images" default_order="sequence">
                <field name="id"/>
                <field name="name"/>
                <field name="image_1920"/>
                <field name="sequence" widget="handle"/>

                <templates>
                    <!-- Odoo 18+ canonical template name -->
                    <t t-name="card">
                    <div class="o_kanban_record card h-100 shadow-sm oe_kanban_global_click p-0">

                        <!-- Square thumbnail -->
                        <div class="ratio ratio-1x1">
                        <t t-if="record.image_1920.raw_value">
                            <img
                            class="card-img-top object-fit-cover"
                            t-att-src="kanban_image('mercadolibre.image', 'image_1920', record.id.raw_value)"
                            t-att-alt="record.name.value || ''"
                            />
                        </t>
                        <t t-else="">
                            <div class="d-flex align-items-center justify-content-center bg-light text-muted">
                            <small>No image</small>
                            </div>
                        </t>
                        </div>

                        <!-- Body -->
                        <div class="card-body p-2">
                        <h6 class="card-title mb-2 text-truncate" t-esc="record.name.value"/>

                        <!-- Size badge (approx from base64 length) -->
                        <t t-set="b64len" t-value="(record.image_1920.raw_value &amp;&amp; record.image_1920.raw_value.length) || 0"/>
                        <t t-set="bytes" t-value="Math.floor(b64len * 0.75)"/>
                        <t t-set="kb" t-value="Math.max(0, Math.floor(bytes / 1024))"/>

                        <t t-if="kb">
                            <t t-set="size_status"
                            t-value="kb &lt; 100 ? 'text-bg-success' : (kb &lt; 1000 ? 'text-bg-warning' : 'text-bg-danger')"/>
                            <t t-set="message"
                            t-value="kb &lt; 100 ? 'Acceptable file size' : (kb &lt; 1000 ? 'Huge file size. Optimize image.' : 'Optimization required! Reduce size or increase compression.')"/>
                            <span t-attf-class="badge rounded-pill #{size_status}"
                                t-att-title="message"
                                t-esc="kb + ' KB'"/>
                        </t>
                        </div>

                        <!-- Drag handle -->
                        <field name="sequence"
                            widget="handle"
                            class="o_kanban_drag_handle position-absolute top-0 end-0 m-1"/>
                    </div>
                    </t>
                </templates>
                </kanban>
            </field>
            </record>



        <record model="ir.actions.act_window" id="action_meli_banners_tree">
            <field name="name">Descripciones</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mercadolibre.banner</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_meli_banners"
            action="action_meli_banners_tree"
            parent="menu_meli"
            name="Descripciones" />

    </data>
</odoo>
