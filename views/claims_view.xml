<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="view_meli_claims_tree">
            <field name="name">mercadolibre.claim.tree</field>
            <field name="model">mercadolibre.claim</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Reclamos" default_order="date_created desc" create="0">
                    <field name="claim_id"/>
                    <field name="date_created"/>
                    <field name="order_id"/>
                    <field name="resource"/>
                    <field name="resource_id"/>
                    <field name="type"/>
                    <field name="stage"/>
                    <field name="status"/>
                    <field name="last_updated"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_meli_claims_form">
            <field name="name">mercadolibre.claim.form</field>
            <field name="model">mercadolibre.claim</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <header>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="claim_id"/>
                                <field name="order_id"/>
                                <field name="resource"/>
                                <field name="resource_id"/>
                                <field name="claim_link" widget="url"/>
                            </group>
                            <group>
                                <field name="type"/>
                                <field name="stage"/>
                                <field name="status"/>
                                <field name="reason_id"/>
                                <field name="date_created"/>
                                <field name="last_updated"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Datos crudos (debug)">
                                <field name="players_json"/>
                                <field name="resolution_json"/>
                                <field name="raw_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_meli_claims_tree">
            <field name="name">Reclamos</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mercadolibre.claim</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_meli_claims"
            action="action_meli_claims_tree"
            parent="menu_meli"
            name="Reclamos"
            sequence="20"/>

    </data>
</odoo>
