<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_conf_settings_meli_form" model="ir.ui.view">
        <field name="name">meli.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='catalog_setting_container']" position="after">
                <block title="Credenciales Mercado Libre" name="mercadolibre_credentials">
                    <setting name="mercadolibre_client_id" string="Client ID" type="char">
                        <field name="mercadolibre_client_id"/>
                    </setting> 
                    <setting name="mercadolibre_secret_key" string="Secret Key" type="char">
                        <field name="mercadolibre_secret_key"/>
                    </setting> 
                    <setting name="mercadolibre_access_token" string="Access Token" type="char">
                        <field name="mercadolibre_access_token"/>
                    </setting> 
                    <setting name="mercadolibre_refresh_token" string="Refresh Token" type="char">
                        <field name="mercadolibre_refresh_token" password="False"/>
                    </setting>
                    <setting name="mercadolibre_sending_message_to_customer" string="Activar/desactivar envio de mensaje a cliente" type="boolean">
                        <field name="mercadolibre_sending_message_to_customer"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
