        <record id="meli_orders_search_view" model="ir.ui.view">
            <field name="name">mercadolibre.orders.search</field>
            <field name="model">mercadolibre.orders</field>
            <field name="arch" type="xml">
    	         <search>
                 <field name="name" string="Order" filter_domain="['|', '|', '|', '|','|', '|', ('name', 'ilike', self), ('order_id', 'ilike', self), ('pack_id', 'ilike', self), ('order_product_sku', 'ilike', self), ('order_product_meli_id', 'ilike', self), ('order_product_meli_variation_id', 'ilike', self), ('buyer', 'ilike', self)]"/>
                 <field name="order_id" string="Order ID"/>
                 <field name="order_product_sku" string="Product SKU"/>
                 <field name="order_product_iva" string="Product IVA"/>
                 <field name="order_product_meli_id" string="Product Meli Id"/>
                 <field name="order_product_meli_variation_id" string="Product Meli Var Id"/>
                 <field name="order_id" string="Order ID"/>
                 <field name="pack_id" string="Pack ID"/>
                 <field name="status" string="Status"/>
                 <field name="buyer" string="Comprador"/>
                 <field name="company_id" string="Compania"/>
                 <field name="seller_id" string="Vendedor"/>
                 <separator/>
                 <filter name="filter_no_product" string="Sin producto asignado"
                         domain="[('order_items.product_id','=',False)]"/>
                 <filter name="filter_has_product" string="Con producto asignado"
                         domain="[('order_items.product_id','!=',False)]"/>
                 <separator/>
                 <filter name="filter_confirmed" string="Confirmadas"
                         domain="[('status','=','confirmed')]"/>
                 <filter name="filter_paid" string="Pagadas"
                         domain="[('status','=','paid')]"/>
                 <filter name="filter_cancelled" string="Canceladas"
                         domain="[('status','=','cancelled')]"/>
                 <separator/>
                 <filter name="filter_has_pack" string="Con Pack"
                         domain="[('pack_id','!=',False)]"/>
                 <separator/>
                 <filter name="group_pack_id" string="Pack Id"
                         context="{'group_by': 'pack_id'}"/>
                 <filter name="group_status" string="Estado"
                         context="{'group_by': 'status'}"/>
                 <filter name="group_logistic_type" string="Tipo logístico"
                         context="{'group_by': 'shipment_logistic_type'}"/>
                 <filter name="group_seller" string="Vendedor"
                         context="{'group_by': 'seller_id'}"/>
                 <filter name="group_buyer" string="Comprador"
                         context="{'group_by': 'buyer'}"/>
                 <filter name="group_shipment_status" string="Estado de envío"
                         context="{'group_by': 'shipment_status'}"/>
    	         </search>
            </field>
        </record>

