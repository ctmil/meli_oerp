<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="sale_order_view_search_inherit_meli" model="ir.ui.view">
            <field name="name">sale.order.search.inherit.meli</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                  <field name="meli_order_id" string="MercadoLibre Order Id"/>
                  <field name="meli_buyer_nickname" string="ML Comprador Nickname"/>
                  <field name="meli_buyer_id" string="ML Comprador ID"/>
                  <field name="meli_receiver_state" string="ML Provincia"/>
                  <field name="meli_receiver_city" string="ML Localidad"/>
                  <field name="meli_receiver_neighborhood" string="ML Barrio"/>
                  <field name="meli_receiver_zip_code" string="ML CP"/>
                  <separator/>
                  <filter string="MercadoLibre Orders" name="sale_orders_ml" domain="[('meli_order_id','!=',False)]" />
                  <!-- Canceladas en ML. Los TRES estados que significan "esta venta no va". -->
                  <filter string="MercadoLibre Canceladas" name="sale_orders_ml_cancelled"
                          domain="[('meli_order_id','!=',False),
                                   ('meli_status','in',['cancelled','pending_cancel','invalid'])]" />
                  <!-- EL ACCIONABLE: replica EXACTO la condicion de
                       _compute_meli_cancel_pending_banner (el banner naranja "Cancelada en
                       MercadoLibre - pendiente en Odoo"). Ese campo es compute store=False y
                       no se puede filtrar por el: si cambia el compute, cambiar este dominio. -->
                  <filter string="MercadoLibre Canceladas pendientes en Odoo" name="sale_orders_ml_cancel_pending"
                          domain="[('meli_order_id','!=',False),
                                   ('meli_status','=','cancelled'),
                                   ('state','!=','cancel')]" />
                  <filter string='Estado de Odoo' domain="[]"
                          context="{'group_by' : 'state'}" name="meli_odoo_state_filter"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_view_search_inherit_quotation_meli" model="ir.ui.view">
            <field name="name">sale.order.search.inherit.quotation.meli</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_quotation']" position="after">
                  <field name="meli_order_id" string="MercadoLibre Order Id"/>
                  <field name="meli_buyer_nickname" string="ML Comprador Nickname"/>
                  <field name="meli_buyer_id" string="ML Comprador ID"/>
                  <field name="meli_receiver_state" string="ML Provincia"/>
                  <field name="meli_receiver_city" string="ML Localidad"/>
                  <field name="meli_receiver_neighborhood" string="ML Barrio"/>
                  <field name="meli_receiver_zip_code" string="ML CP"/>
                  <!--field name="meli_status_brief" string="MercadoLibre Status Brief"/-->
                  <field name="meli_status" string="MercadoLibre Status"/>
                  <field name="meli_update_forbidden" string="No actualizar desde ML"/>

                  <separator/>
                  <filter string="Con mensajes del comprador sin leer" name="meli_unread_msgs" domain="[('meli_unread_messages','>',0)]" />
                  <filter string="MercadoLibre Quotations" name="sale_orders_ml" domain="[('meli_order_id','!=',False)]" />
                  <!-- Canceladas en ML. Los TRES estados que significan "esta venta no va". -->
                  <filter string="MercadoLibre Canceladas" name="sale_orders_ml_cancelled"
                          domain="[('meli_order_id','!=',False),
                                   ('meli_status','in',['cancelled','pending_cancel','invalid'])]" />
                  <!-- EL ACCIONABLE: replica EXACTO la condicion de
                       _compute_meli_cancel_pending_banner (el banner naranja "Cancelada en
                       MercadoLibre - pendiente en Odoo"). Ese campo es compute store=False y
                       no se puede filtrar por el: si cambia el compute, cambiar este dominio. -->
                  <filter string="MercadoLibre Canceladas pendientes en Odoo" name="sale_orders_ml_cancel_pending"
                          domain="[('meli_order_id','!=',False),
                                   ('meli_status','=','cancelled'),
                                   ('state','!=','cancel')]" />
                  <filter string='Estado de Odoo' domain="[]"
                          context="{'group_by' : 'state'}" name="meli_odoo_state_filter"/>
                  <filter string='MercadoLibre Status' domain="[]"
        								context="{'group_by' : 'meli_status'}" name="meli_status_filter"/>
                  <!--filter string='MercadoLibre Status Brief' domain="[]"
        								context="{'group_by' : 'meli_status_brief'}" name="meli_status_brief_filter"/-->
                  <filter string='MercadoLibre Logistic Type' domain="[]"
                        context="{'group_by' : 'meli_shipment_logistic_type'}" name="meli_shipment_logistic_type_filter"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="view_meli_orders_tree">
            <field name="name">mercadolibre.orders.tree</field>
            <field name="model">mercadolibre.orders</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Ordenes" default_order="date_created desc">
                    <field name="company_id"/>
                    <field name="seller_id"/>
                    <field name="name"/>
                    <field name="order_id"/>
                    <field name="pack_id"/>
                    <field name="shipping_id" invisible="0"/>
                    <field name="order_product"/>
                    <field name="order_product_sku"/>
                    <field name="order_product_meli_id"/>
                    <field name="status"/>
                    <field name="shipment_status" invisible="0"/>
                    <field name="shipment_substatus" invisible="0"/>
                    <field name="shipment_logistic_type" invisible="0"/>
                    <field name="buyer"/>
                    <field name="total_amount"/>
                    <field name="paid_amount"/>
                    <field name="coupon_amount"/>
                    <field name="order_product_iva"/>
                    <field name="date_created"/>
                    <field name="date_closed"/>
                    <field name="tags" invisible="1"/>
                    <field name="context" invisible="0"/>
                    <field name="pack_order" string="Es Carrito"/>
                    <field name="catalog_order" string="Es de Catalogo"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_sale_order_form_meli">
            <field name="name">sale.order.form.meli</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <data>
                    <!-- Banner de cancelación ML: visible solo en órdenes canceladas en Odoo -->
                    <!-- Banner de acción requerida: cancelada en ML pero NO en Odoo -->
                    <xpath expr="//div[@name='button_box']" position="after">
                        <field name="meli_cancel_pending_banner" widget="html" readonly="1" nolabel="1"
                               invisible="not meli_cancel_pending_banner"/>
                        <field name="meli_cancel_banner" widget="html" readonly="1" nolabel="1"
                               invisible="not meli_cancel_banner"/>
                    </xpath>

                    <!-- Botón de reparación: visible cuando la orden está confirmada pero
                         no tiene entrega (orphan stock moves sin picking_id) -->
                    <xpath expr="//div[@name='button_box']" position="inside">
                        <field name="picking_ids" invisible="1"/>
                        <button name="meli_repair_missing_pickings" type="object"
                                string="Reparar entrega"
                                icon="fa-wrench"
                                class="oe_stat_button"
                                invisible="state not in ('sale','done') or picking_ids"
                                confirm="¿Reparar los movimientos de stock huérfanos y crear la entrega faltante?"
                                groups="base.group_system"/>
                    </xpath>

                    <notebook>
                        <page string="MercadoLibre" invisible="meli_order_id==False"
                                groups="meli_oerp.group_mercadolibre_manager">
                            <button name='meli_oerp_update' type="object"
                            string="Actualizar"
                            invisible="meli_order_id==False"
                            class="oe_stat_button"
                            icon="fa-refresh"/>
                            <button name='meli_oerp_print' type="object"
                              string="Imprimir guia"
                              invisible="meli_order_id==False"
                              class="oe_stat_button"
                              icon="fa-print"/>
                            <field name="meli_orders" invisible="0"/>
                            <group>
                              <field name="meli_order"/>
                              <field name="meli_buyer"/>
                              <field name="meli_buyer_name"/>
                              <field name="meli_buyer_nickname"/>
                              <field name="meli_buyer_id"/>
                              <field name="meli_update_forbidden" string="No actualizar desde ML"/>
                              <field name="meli_order_id" invisible="0"/>
                              <field name="meli_status" invisible="0"/>
                              <field name="meli_unread_messages" readonly="1"
                                     decoration-warning="meli_unread_messages > 0" widget="badge"/>
                              <field name="meli_messages_link" widget="url" readonly="1"
                                     invisible="meli_unread_messages == 0"/>
                              <!--field name="meli_status_brief" invisible="0"/-->
                              <field name="meli_shipment" invisible="0"/>
                              <field name="meli_receiver_state" readonly="1"/>
                              <field name="meli_receiver_city" readonly="1"/>
                              <field name="meli_receiver_neighborhood" readonly="1"/>
                              <field name="meli_receiver_zip_code" readonly="1"/>
                              <field name="meli_shipment_pdf_file" filename="meli_shipment_pdf_filename" invisible="0"/>
                              <field name="meli_shipment_pdf_filename" invisible="0"/>
                              <field name="meli_shipment_logistic_type" invisible="0"/>
                              <field name="meli_handling_limit" readonly="1"
                                     string="Límite despacho ML"/>
                              <field name="meli_handling_limit_status" readonly="1" widget="badge"
                                     decoration-success="meli_handling_limit_status == 'ok'"
                                     decoration-warning="meli_handling_limit_status == 'urgent'"
                                     decoration-danger="meli_handling_limit_status == 'overdue'"
                                     decoration-muted="meli_handling_limit_status == 'none'"/>
                              <field name="meli_status_detail" invisible="0"/>
                              <field name="meli_total_amount" widget="monetary" invisible="0"/>
                              <field name="meli_shipping_amount" widget="monetary" invisible="0"/>
                              <field name="meli_shipping_cost" widget="monetary" invisible="0"/>
                              <field name="meli_shipping_list_cost" widget="monetary" invisible="0"/>
                              <field name="meli_shipping_seller_cost"  widget="monetary"/>
                              <field name="meli_fee_amount" widget="monetary" invisible="0"/>
                              <field name="meli_paid_amount" widget="monetary" invisible="0"/>
                              <field name="meli_coupon_amount" widget="monetary" invisible="0"/>
                              <field name="meli_discount_seller_amount" widget="monetary" invisible="0"/>
                              <field name="meli_financing_fee_amount" widget="monetary" invisible="0"/>
                              <field name="meli_currency_id" invisible="0"/>
                              <field name="meli_date_created" invisible="0"/>
                              <field name="meli_date_closed" invisible="0"/>
                            </group>
                        </page>
                    </notebook>
                </data>
            </field>
        </record>

        <record model="ir.ui.view" id="view_res_partner_form_meli">
